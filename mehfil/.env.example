PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Optional: Add your YouTube Data API v3 key for server-side dynamic YouTube searches
# If left blank, Mehfil automatically relies on its rich built-in curated catalog
YOUTUBE_API_KEY=

# Optional persistent storage path. Leave blank on Render Free (ephemeral storage).
# Only set this when a writable persistent disk is mounted.
DB_PATH=
